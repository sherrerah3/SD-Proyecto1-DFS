# Local-development secrets only. Replace these values outside development.
METANODE_JWT_SECRET=local-dev-jwt-secret-change-me-2026
DFSHA_CAPABILITY_SECRET=local-dev-capability-secret-change-me-2026
DFSHA_CLUSTER_SECRET=local-dev-cluster-secret-change-me-2026

# Exactly 64 hexadecimal characters (32 bytes) for AES-256 encryption at rest.
# Keep this key unchanged while you need to read existing encrypted blocks.
DFSHA_DATANODE_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
